---
/**
 * Base layout: SEO head (canonical, hreflang, Open Graph, JSON-LD),
 * fonts, global styles, nav and footer.
 */
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import FooterFull from '../components/FooterFull.astro';
import FooterCompact from '../components/FooterCompact.astro';
import {
  abs,
  routes,
  SITE_NAME,
  COMPANY,
  LINKEDIN_URL,
  LINKEDIN_DAAN,
  LINKEDIN_JANWILLEM,
  EMAIL_DAAN,
  EMAIL_JANWILLEM,
  PHONE_TEL,
  ui,
  type Lang,
} from '../lib/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page (NL variant) and its EN alternate, for canonical + hreflang. */
  path: string;
  altPath: string;
  navVariant?: 'overlay' | 'solid';
  ctaHref?: string;
  footer?: 'full' | 'compact-bg' | 'compact-white' | 'none';
  ogType?: 'website' | 'article';
  /** Page-specific share image (site-absolute path); falls back to the default OG card. */
  ogImage?: { src: string; width: number; height: number; alt?: string };
  /** Additional page-specific JSON-LD blocks. */
  schema?: Record<string, unknown>[];
}
const {
  lang,
  title,
  description,
  path,
  altPath,
  navVariant = 'solid',
  ctaHref,
  footer = 'full',
  ogType = 'website',
  ogImage: ogImageProp,
  schema = [],
} = Astro.props;

const t = ui[lang];
const canonical = abs(path);
const alternate = abs(altPath);
const nlUrl = lang === 'nl' ? canonical : alternate;
const enUrl = lang === 'en' ? canonical : alternate;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
/* The default card exists per language (scripts/generate-og.ts): an English
   page used to share a Dutch tagline. */
const og = ogImageProp ?? { src: `/og/og-default-${lang}.png`, width: 1200, height: 630 };
const ogImage = abs(og.src);
const ogImageAlt = og.alt ?? t.ogImageAlt;

const organization = {
  '@type': 'Organization',
  '@id': abs('/#organization'),
  name: SITE_NAME,
  legalName: COMPANY.legalName,
  url: abs('/'),
  logo: abs('/og/logo-mark.png'),
  address: {
    '@type': 'PostalAddress',
    streetAddress: COMPANY.street,
    postalCode: COMPANY.postalCode,
    addressLocality: COMPANY.city,
    addressCountry: COMPANY.country,
  },
  identifier: { '@type': 'PropertyValue', propertyID: 'KVK', value: COMPANY.kvk },
  description:
    lang === 'nl'
      ? 'Gespecialiseerde Exact Online Premium integratiepartner en hyperautomation consultancy. Integraties, workflow-orkestratie, RPA, training en Claire, de AI-laag boven op Exact Online.'
      : 'Specialised Exact Online Premium integration partner and hyperautomation consultancy. Integrations, workflow orchestration, RPA, training and Claire, the AI layer on top of Exact Online.',
  sameAs: [LINKEDIN_URL],
  email: EMAIL_DAAN,
  telephone: PHONE_TEL,
  areaServed: 'NL',
  founder: [
    { '@type': 'Person', name: 'Daan Jansen', jobTitle: 'Co-founder · Financial Consultant', email: `mailto:${EMAIL_DAAN}`, sameAs: [LINKEDIN_DAAN] },
    { '@type': 'Person', name: 'Jan-Willem Gmelig Meyling', jobTitle: 'Co-founder · Solution Architect', email: `mailto:${EMAIL_JANWILLEM}`, sameAs: [LINKEDIN_JANWILLEM] },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: EMAIL_DAAN,
    telephone: PHONE_TEL,
    url: abs(routes.about[lang]),
    availableLanguage: ['nl', 'en'],
  },
};

const website = {
  '@type': 'WebSite',
  '@id': abs('/#website'),
  url: abs('/'),
  name: SITE_NAME,
  publisher: { '@id': abs('/#organization') },
  inLanguage: ['nl-NL', 'en'],
};

const jsonLd = { '@context': 'https://schema.org', '@graph': [organization, website, ...schema] };
---
<!doctype html>
<html lang={lang === 'nl' ? 'nl-NL' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="nl" href={nlUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={nlUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* The SVG is what browsers pick. The rasters are for Google Search,
        which reads the favicon off the home page, wants a square of at least
        48x48 and prefers ICO/PNG over SVG. They also serve the favicon services
        other products resolve a site's icon through. /favicon.ico is probed by
        convention, without this document being read at all. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <meta name="theme-color" content="#0D1B27" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'nl' ? 'en_US' : 'nl_NL'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700;800&display=swap" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Marks the document as JS-capable before the first paint, which is what lets
        global.css hide [data-reveal] up front instead of blanking it mid-scroll.
        The timeout is a safety net: if the reveal script never runs, drop the flag
        so the content shows anyway. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('df-js');
        setTimeout(function () {
          if (!root.hasAttribute('data-df-reveals')) root.classList.remove('df-js');
        }, 3000);
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t.skip}</a>
    <SiteNav lang={lang} variant={navVariant} ctaHref={ctaHref ?? routes.about[lang]} altHref={altPath} />
    <main id="main">
      <slot />
    </main>
    {footer === 'full' && <FooterFull lang={lang} />}
    {footer === 'compact-bg' && <FooterCompact lang={lang} tone="bg" />}
    {footer === 'compact-white' && <FooterCompact lang={lang} tone="white" />}
  </body>
</html>
