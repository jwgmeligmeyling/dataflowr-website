const H = 124.98, MARKW = 95.97, LOCKW = 565.31;
const vw = mode === 'mark' ? MARKW : LOCKW;
const y0 = dots ? 0 : 38.88;
const vh = H - y0;
const wpx = (h * vw) / vh;

// Build-time unique id per instance for clip path / gradients.
const uid = 'dfl' + Math.random().toString(36).slice(2, 9);
const faces = [
  { key: 'Boven', fb: '#2FBF71', d: BOVEN },
  { key: 'Onder', fb: '#0A1E42', d: ONDER },
  { key: 'Rechts', fb: '#2563EB', d: RECHTS },
];
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 ${y0} ${vw} ${vh}`}
  width={wpx}
  height={h}
  style={`display:block;overflow:visible;${style ?? ''}`}
  class={className}
  role="img"
  aria-label="DataFlowr"
>
  <defs>
    <clipPath id={uid}><path d={DBASE}></path></clipPath>
    {faces.map((f) => (
      <linearGradient id={uid + f.key} gradientUnits="userSpaceOnUse" x1="14" y1="38.88" x2="82" y2="124.98">
        <stop offset="0" style={`stop-color:var(--logo${f.key}A,var(--logo${f.key},${f.fb}))`}></stop>
        <stop offset="1" style={`stop-color:var(--logo${f.key}B,var(--logo${f.key},${f.fb}))`}></stop>
      </linearGradient>
    ))}
  </defs>
  <path d={DBASE} fill="var(--logoBase,#FFFFFF)"></path>
  <g clip-path={`url(#${uid})`}>
    {faces.map((f) => <path d={f.d} fill={`url(#${uid + f.key})`}></path>)}
  </g>
  {dots && DOTS.map((dt, i) => <circle cx={dt.cx} cy={dt.cy} r={dt.r} fill={`var(--logoDot${i + 1},#0A1E42)`}></circle>)}
  {mode !== 'mark' && (
    <g fill="var(--logoText,#0A1E42)">
      {GLYPHS.map((g) => <path d={g}></path>)}
    </g>
  )}
</svg>
