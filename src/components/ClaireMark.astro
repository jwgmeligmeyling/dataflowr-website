---
/**
 * Claire mark — the finance agent's face on the marketing funnel and in the app.
 * Squircle in a blue→teal ramp with an open "C" aperture; the spark is what
 * separates it from a plain monogram at favicon sizes.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 48, class: className } = Astro.props;
/** Unique per instance so gradient ids never collide on one page. */
const uid = 'cm' + Math.random().toString(36).slice(2, 8);
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class={className}
  role="img"
  aria-label="Claire"
  style="display:block"
>
  <defs>
    <linearGradient id={`${uid}body`} x1="8" y1="6" x2="92" y2="96" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#3E8BEE"></stop>
      <stop offset=".55" stop-color="#2169DE"></stop>
      <stop offset="1" stop-color="#2AB3B0"></stop>
    </linearGradient>
    <linearGradient id={`${uid}sheen`} x1="20" y1="14" x2="70" y2="70" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#ffffff" stop-opacity=".38"></stop>
      <stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop>
    </linearGradient>
  </defs>
  <rect x="2" y="2" width="96" height="96" rx="30" fill={`url(#${uid}body)`}></rect>
  <rect x="2" y="2" width="96" height="96" rx="30" fill={`url(#${uid}sheen)`}></rect>
  <path d="M69 34.5a24.5 24.5 0 1 0 0 31" fill="none" stroke="#fff" stroke-width="9.5" stroke-linecap="round"></path>
  <path d="M78 14.6 L80.2 20.8 L86.4 23 L80.2 25.2 L78 31.4 L75.8 25.2 L69.6 23 L75.8 20.8 Z" fill="#fff" opacity=".95"></path>
</svg>
