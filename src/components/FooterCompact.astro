---
/** Compact footer (article + about pages). */
import Logo from './Logo.astro';
import { routes, ui, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  /** Article variant sits on white with a --line border. */
  tone?: 'bg' | 'white';
}
const { lang, tone = 'bg' } = Astro.props;
const t = ui[lang];
---
<footer class={`compact compact--${tone}`}>
  <div class="wrap inner">
    {/* Two poles: mark and copyright left, the legal pages as fine print right. */}
    <div class="ident">
      <span class="lockup"><Logo mode="mark" h={20} /><span class="name">DataFlowr</span></span>
      <p class="legal">{t.footerCompact}</p>
    </div>
    <div class="legal-run">
      <a href={routes.contact[lang]}>{t.contactPage}</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href={routes.support[lang]}>{t.supportPage}</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href={routes.legal.privacy[lang]}>{t.footerPrivacy}</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href={routes.legal.terms[lang]}>{t.footerTerms}</a>
    </div>
  </div>
</footer>

<style>
  .compact--bg { border-top: 1px solid color-mix(in srgb, var(--brand) 9%, transparent); }
  .compact--white { border-top: 1px solid var(--line); background: #ffffff; }
  .inner {
    padding-top: 28px;
    padding-bottom: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    font-size: 0.84375rem;
    color: var(--muted);
  }
  .lockup { display: flex; align-items: center; gap: 9px; }
  .name { font-weight: 600; color: var(--brand); }
  .ident { display: flex; flex-wrap: wrap; gap: 16px 22px; align-items: center; }
  .legal { margin: 0; }
  .legal-run { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .legal-run a { color: inherit; }
  .legal-run a:hover { color: var(--hl); }
  .dot { color: color-mix(in srgb, var(--brand) 28%, transparent); }
</style>
