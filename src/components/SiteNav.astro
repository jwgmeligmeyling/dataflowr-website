---
/**
 * Canonical navigation bar (identical across all pages, per design review).
 * variant="overlay" — home only: translucent, blurred, hero slides under it.
 * variant="solid"   — subpages: solid brand background.
 */
import Logo from './Logo.astro';
import { routes, ui, type Lang, type ServiceKey } from '../lib/site';

interface Props {
  lang: Lang;
  variant?: 'overlay' | 'solid';
  /** Where the "Plan een kennismaking" pill points on this page. */
  ctaHref: string;
  /** URL of this page in the other language (language switcher target). */
  altHref: string;
}
const { lang, variant = 'solid', ctaHref, altHref } = Astro.props;
const t = ui[lang];
const serviceKeys = Object.keys(routes.services) as ServiceKey[];
---
<header class={`site-nav ${variant === 'overlay' ? 'site-nav--overlay' : 'site-nav--solid'}`}>
  <div class="wrap bar">
    <a href={routes.home[lang]} aria-label="DataFlowr, home" class="brand-link">
      <Logo mode="mark" h={30} />
      <span class="brand-name">DataFlowr</span>
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="site-menu" data-nav-toggle>
      <span class="nav-toggle-label">{t.menu}</span>
      <span class="nav-toggle-icon" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <nav id="site-menu" class="menu" aria-label={lang === 'nl' ? 'Hoofdnavigatie' : 'Main navigation'}>
      <details class="dd" data-nav-dd>
        <summary><span>{t.solutions}</span><span class="caret" aria-hidden="true">▼</span></summary>
        <div class="panel">
          <span class="panel-heading">{t.product}</span>
          <a href={routes.claire[lang]} class="claire-item">
            <span class="claire-badge" aria-hidden="true">C</span>
            <span class="claire-text">
              <span class="claire-name">Claire</span>
              <span class="claire-sub">{t.claireTag}</span>
            </span>
          </a>
          <span class="panel-heading panel-heading--rule">{t.services}</span>
          {serviceKeys.map((key) => (
            <a href={routes.services[key][lang]} class="svc-item">
              <span class="svc-name">{t.serviceNavTitles[key]}</span>
              <span class="svc-sub">{t.serviceNavDescriptions[key]}</span>
            </a>
          ))}
        </div>
      </details>
      <a href={routes.article[lang]} class="nav-link">{t.resources}</a>
      <a href={routes.about[lang]} class="nav-link">{t.about}</a>
      <a href={routes.claireStart[lang]} class="nav-link">{t.signIn}</a>
      <a href={ctaHref} class="nav-cta">{t.cta}</a>
      <a href={altHref} class="lang-switch" aria-label={t.langSwitchLabel} rel="alternate" hreflang={lang === 'nl' ? 'en' : 'nl'}>🌐 {t.langSwitch}</a>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 80;
    border-bottom: 1px solid color-mix(in srgb, var(--bg) 10%, transparent);
  }
  .site-nav--solid { background: var(--brand); }
  .site-nav--overlay {
    z-index: 60;
    background: color-mix(in srgb, var(--brand) 78%, transparent);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
  }
  .bar {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand-link {
    display: flex;
    align-items: center;
    gap: 11px;
    --logoBase: transparent;
  }
  .brand-name { font-size: 21px; font-weight: 700; letter-spacing: -0.02em; color: var(--bg); }

  .menu {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.6vw, 24px);
    font-size: 13.5px;
    font-weight: 500;
    min-width: 0;
  }
  .nav-link, .dd summary { white-space: nowrap; color: color-mix(in srgb, var(--bg) 74%, transparent); }
  .nav-link:hover { color: var(--bg); }
  .dd { position: relative; }
  .dd summary { display: flex; align-items: center; gap: 6px; }
  .caret { font-size: 9px; opacity: 0.7; }
  .panel {
    position: absolute;
    top: calc(100% + 16px);
    left: -16px;
    width: 336px;
    background: #ffffff;
    border: 1px solid color-mix(in srgb, var(--brand) 12%, transparent);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(13, 27, 39, 0.24);
    padding: 10px;
    display: grid;
    gap: 2px;
    z-index: 90;
  }
  .panel-heading {
    padding: 8px 14px 4px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .panel-heading--rule {
    margin-top: 8px;
    padding: 10px 14px 4px;
    border-top: 1px solid color-mix(in srgb, var(--brand) 12%, transparent);
  }
  .claire-item {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 12px 14px;
    border-radius: 11px;
    background: color-mix(in srgb, var(--pos) 14%, transparent);
  }
  .claire-item:hover { background: color-mix(in srgb, var(--pos) 24%, transparent); }
  .claire-badge {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--pos);
    color: var(--brand);
    font-weight: 700;
    font-size: 14px;
    display: grid;
    place-items: center;
  }
  .claire-text { display: grid; gap: 1px; min-width: 0; }
  .claire-name { font-size: 14px; font-weight: 700; color: var(--brand); }
  .claire-sub { font-size: 12px; color: var(--muted); }
  .svc-item { display: grid; gap: 2px; padding: 10px 14px; border-radius: 10px; color: var(--brand); }
  .svc-item:hover { background: color-mix(in srgb, var(--brand) 5%, transparent); color: var(--brand); }
  .svc-name { font-size: 14px; font-weight: 600; }
  .svc-sub { font-size: 12px; color: var(--muted); }

  .nav-cta {
    white-space: nowrap;
    background: var(--signal);
    color: var(--signalText);
    font-weight: 700;
    font-size: 13px;
    padding: 10px 18px;
    border-radius: 99px;
    transition: box-shadow 0.3s, transform 0.3s;
  }
  .nav-cta:hover {
    box-shadow: 0 6px 30px color-mix(in srgb, var(--signal) 55%, transparent);
    transform: translateY(-1px);
    color: var(--signalText);
  }
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 6px;
    border: 1px solid color-mix(in srgb, var(--bg) 26%, transparent);
    border-radius: 99px;
    padding: 7px 12px;
    font-size: 12px;
    font-weight: 600;
    color: color-mix(in srgb, var(--bg) 80%, transparent);
    white-space: nowrap;
  }
  .lang-switch:hover { border-color: color-mix(in srgb, var(--bg) 55%, transparent); color: var(--bg); }

  .nav-toggle {
    display: none;
    align-items: center;
    gap: 10px;
    background: none;
    border: 1px solid color-mix(in srgb, var(--bg) 26%, transparent);
    border-radius: 99px;
    padding: 8px 14px;
    color: color-mix(in srgb, var(--bg) 80%, transparent);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
  }
  .nav-toggle-icon { display: grid; gap: 3px; }
  .nav-toggle-icon i { display: block; width: 14px; height: 2px; background: currentColor; border-radius: 2px; }

  /* Mobile: the prototype only specifies desktop; collapse to a panel that
     reuses the same links and styling language. */
  @media (max-width: 980px) {
    .nav-toggle { display: flex; }
    .menu {
      display: none;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      background: var(--brand);
      border-bottom: 1px solid color-mix(in srgb, var(--bg) 12%, transparent);
      padding: 14px 22px 22px;
      box-shadow: 0 30px 60px rgba(13, 27, 39, 0.35);
    }
    .menu.is-open { display: flex; }
    .nav-link, .dd summary { padding: 10px 2px; font-size: 15px; }
    .dd .panel { position: static; width: auto; margin: 4px 0 8px; }
    .nav-cta { text-align: center; margin-top: 8px; padding: 13px 18px; font-size: 14px; }
    .lang-switch { justify-content: center; }
  }
</style>

<script>
  // Dropdown/menu behavior: close the Oplossingen panel on outside click or
  // Escape; hamburger toggles the mobile panel.
  document.querySelectorAll<HTMLElement>('[data-nav-toggle]').forEach((btn) => {
    const menu = document.getElementById('site-menu');
    btn.addEventListener('click', () => {
      const open = menu?.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('[data-nav-dd][open]').forEach((dd) => {
      if (!dd.contains(e.target as Node)) dd.removeAttribute('open');
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('[data-nav-dd][open]').forEach((dd) => dd.removeAttribute('open'));
  });
</script>
