---
/**
 * Service page: implementation of the "Dienst *.dc.html" template.
 * One template, six services; copy comes from src/data/services.ts.
 * The Exact Online Premium page has no "Resultaat" section (per design review).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../Logo.astro';
import { abs, routes, ui, type Lang, type ServiceKey } from '../../lib/site';
import { services, relatedCards, type RelatedKey } from '../../data/services';

interface Props {
  lang: Lang;
  serviceKey: ServiceKey;
}
const { lang, serviceKey } = Astro.props;
const other: Lang = lang === 'nl' ? 'en' : 'nl';
const t = ui[lang];
const s = services[lang][serviceKey];
const rel = relatedCards[lang];

const str = {
  nl: {
    breadcrumb: 'Diensten',
    heroCta: 'Plan een kennismaking',
    heroCta2: 'Zo werken wij',
    factsHeading: 'Kenmerkend voor deze dienst',
    deliverEyebrow: 'Wat we leveren',
    approachEyebrow: 'Zo werken wij',
    approachTitle: 'In vier stappen live.',
    approachSub:
      'Geen ellenlange implementatie. Vooraf is duidelijk wat er gebeurt, wie wat doet en wat de oplevering omvat, en na livegang houd je één vast aanspreekpunt.',
    approachSteps: [
      { num: '01', title: 'Quickscan', body: 'Processen, volumes en knelpunten in kaart, met een doorrekening van de verwachte besparing.' },
      { num: '02', title: 'Ontwerp', body: 'Wij ontwerpen de flow rond controls en auditability, en spreken af wat de oplevering omvat.' },
      { num: '03', title: 'Bouw & onboarding', body: 'Wij bouwen in korte cycli, testen op je echte data en leiden je team op in het resultaat.' },
      { num: '04', title: 'Onderhoud', body: 'Wij onderhouden de oplossing en blijven betrokken; nieuwe functionaliteit komt vanzelf beschikbaar.' },
    ],
    resultsTitle: 'Wat je eraan overhoudt.',
    relatedTitle: 'Vaak in combinatie met',
    relatedSub: 'Zelden één discipline op zichzelf. Dit is waar deze dienst meestal mee samengaat.',
    ctaTitle: 'Benieuwd wat dit voor jou zou betekenen?',
    ctaSub: 'Plan een kennismaking van 30 minuten, vrijblijvend, en je spreekt direct een founder.',
    ctaBtn: 'Plan een kennismaking',
    ctaBtn2: 'Maak kennis met Claire',
  },
  en: {
    breadcrumb: 'Services',
    heroCta: 'Get in touch',
    heroCta2: 'How we work',
    factsHeading: 'Typical for this service',
    deliverEyebrow: 'What we deliver',
    approachEyebrow: 'How we work',
    approachTitle: 'Live in four steps.',
    approachSub:
      'No endless implementation. Up front it is clear what happens, who does what and what delivery includes, and after go-live you keep one fixed point of contact.',
    approachSteps: [
      { num: '01', title: 'Quickscan', body: 'Processes, volumes and bottlenecks mapped, with a calculation of the expected saving.' },
      { num: '02', title: 'Design', body: 'We design the flow around controls and auditability, and agree what delivery includes.' },
      { num: '03', title: 'Build & onboarding', body: 'We build in short cycles, test against your real data and train your team on the result.' },
      { num: '04', title: 'Maintenance', body: 'We maintain the solution and stay involved; new functionality becomes available automatically.' },
    ],
    resultsTitle: 'What you are left with.',
    relatedTitle: 'Often combined with',
    relatedSub: 'Rarely one discipline on its own. This is where this service is usually paired.',
    ctaTitle: 'Curious what this would mean for you?',
    ctaSub: 'Book a 30-minute intro, no strings, and you will speak to a founder directly.',
    ctaBtn: 'Get in touch',
    ctaBtn2: 'Meet Claire',
  },
}[lang];

const relatedHref = (key: RelatedKey) => (key === 'claire' ? routes.claire[lang] : routes.services[key][lang]);

const path = routes.services[serviceKey][lang];
const altPath = routes.services[serviceKey][other];

const schema = [
  {
    '@type': 'Service',
    '@id': abs(`${path}#service`),
    name: s.nav,
    description: s.metaDescription,
    url: abs(path),
    provider: { '@id': abs('/#organization') },
    areaServed: 'NL',
    serviceType: s.nav,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: abs(routes.home[lang]) },
      { '@type': 'ListItem', position: 2, name: str.breadcrumb, item: abs(routes.servicesIndex[lang]) },
      { '@type': 'ListItem', position: 3, name: s.nav, item: abs(path) },
    ],
  },
];
---
<BaseLayout
  lang={lang}
  title={s.metaTitle}
  description={s.metaDescription}
  path={path}
  altPath={altPath}
  navVariant="solid"
  footer="full"
  schema={schema}
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="nebula hero-nebula" aria-hidden="true"><Logo mode="mark" h={700} /></div>
    <div class="wrap hero-wrap">
      <nav aria-label={lang === 'nl' ? 'Kruimelpad' : 'Breadcrumb'} class="crumbs">
        <a href={routes.home[lang]}>{t.home}</a>
        <span>/</span><a href={routes.servicesIndex[lang]}>{str.breadcrumb}</a><span>/</span>
        <span class="crumb-current">{s.nav}</span>
      </nav>
      <div class="hero-grid">
        <div>
          <p class="eyebrow eyebrow--teal">{s.eyebrow}</p>
          <h1>{s.title}</h1>
          <p class="hero-intro">{s.intro}</p>
          <div class="hero-ctas">
            <a href={routes.about[lang]} class="btn-signal hero-btn">{str.heroCta}</a>
            <a href="#aanpak" class="btn-ghost-dark hero-btn2">{str.heroCta2}</a>
          </div>
        </div>
        <div class="facts">
          <p class="facts-heading">{str.factsHeading}</p>
          <ul>
            {s.facts.map((f) => <li><span class="dot dot--teal"></span>{f}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WAT WE DOEN ============ -->
  <section class="deliver">
    <div class="wrap deliver-wrap">
      <p class="eyebrow">{str.deliverEyebrow}</p>
      <h2>{s.doTitle}</h2>
      <div class="deliver-grid">
        {s.deliverables.map((d) => (
          <div class="deliver-card">
            <span class="deliver-num">{d.num}</span>
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ AANPAK ============ -->
  <section id="aanpak" class="approach">
    <div class="wrap approach-wrap">
      <p class="eyebrow">{str.approachEyebrow}</p>
      <h2>{str.approachTitle}</h2>
      <p class="approach-sub">{str.approachSub}</p>
      <div class="approach-grid">
        {str.approachSteps.map((step) => (
          <div class="approach-card">
            <span class="approach-num">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {s.results && (
    <section class="results">
      <div class="nebula results-nebula" aria-hidden="true"><Logo mode="mark" h={600} /></div>
      <div class="wrap results-wrap">
        <h2>{str.resultsTitle}</h2>
        <div class="results-grid">
          {s.results.map((r) => (
            <div class="result">
              <p class="result-stat">{r.stat}</p>
              <h3>{r.title}</h3>
              <p class="result-body">{r.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ COMBINEERT MET ============ -->
  <section class="related">
    <div class="wrap related-wrap">
      <h2>{str.relatedTitle}</h2>
      <p class="related-sub">{str.relatedSub}</p>
      <div class="related-grid">
        {s.related.map((key) => (
          <a href={relatedHref(key)} class="related-card">
            <span class="related-kind">{rel[key].kind}</span>
            <h3>{rel[key].title}</h3>
            <p>{rel[key].body}</p>
            <span class="related-cta">{rel[key].cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section id="cta" class="cta">
    <div class="cta-wrap">
      <h2>{str.ctaTitle}</h2>
      <p class="cta-sub">{str.ctaSub}</p>
      <div class="cta-btns">
        <a href={routes.about[lang]} class="btn-signal cta-btn">{str.ctaBtn}</a>
        <a href={routes.claire[lang]} class="cta-btn2">{str.ctaBtn2}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; background: var(--brand); color: var(--bg); }
  .hero-nebula {
    position: absolute;
    right: -120px;
    top: -200px;
    filter: blur(110px) saturate(1.15);
    opacity: 0.4;
    --logoBase: transparent;
    --logoBovenA: #FF301D; --logoBovenB: #FF301D;
    --logoOnderA: #1B5FB3; --logoOnderB: #1B5FB3;
    --logoRechtsA: #4DCBC9; --logoRechtsB: #4DCBC9;
  }
  .hero-wrap { position: relative; padding-top: 56px; padding-bottom: 78px; }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 30px;
    font-size: 0.84375rem;
    color: color-mix(in srgb, var(--bg) 56%, transparent);
  }
  .crumbs a { color: color-mix(in srgb, var(--bg) 56%, transparent); }
  .crumbs a:hover { color: var(--bg); }
  .crumb-current { color: var(--bg); font-weight: 600; }
  .hero-grid { display: grid; grid-template-columns: 1.2fr minmax(0, 400px); gap: 56px; align-items: center; }
  @media (max-width: 1020px) { .hero-grid { grid-template-columns: 1fr; gap: 40px; } }
  .hero .eyebrow { margin-bottom: 20px; }
  .hero h1 {
    margin: 0 0 22px;
    max-width: 800px;
    font-size: clamp(2.375rem, 4.6vw, 3.75rem);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero-intro {
    margin: 0 0 32px;
    max-width: 600px;
    font-size: 1.15625rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--bg) 78%, transparent);
    text-wrap: pretty;
  }
  .hero-ctas { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .hero-btn { font-size: 1.03125rem; padding: 16px 30px; }
  .hero-btn2 { font-size: 1.03125rem; padding: 15px 28px; }
  .facts {
    background: color-mix(in srgb, #ffffff 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--bg) 16%, transparent);
    border-radius: 18px;
    padding: 26px;
    backdrop-filter: blur(8px);
  }
  .facts-heading {
    margin: 0 0 16px;
    font-size: 0.71875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .facts ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 13px; }
  .facts li {
    display: flex;
    gap: 11px;
    align-items: flex-start;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--bg) 86%, transparent);
  }
  .dot { flex: none; width: 6px; height: 6px; border-radius: 50%; margin-top: 7px; background: var(--pos); }
  .dot--teal { background: var(--teal); }

  /* ---------- Shared section headings ---------- */
  h2 {
    margin: 0 0 46px;
    max-width: 680px;
    font-size: clamp(1.75rem, 3.4vw, 2.625rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* ---------- Wat we doen ---------- */
  .deliver { background: #ffffff; }
  .deliver-wrap { padding-top: 84px; padding-bottom: 84px; }
  .deliver-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(290px, 100%), 1fr)); gap: 16px; }
  .deliver-card {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px;
    display: grid;
    gap: 10px;
    align-content: start;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .deliver-card:hover { transform: translateY(-3px); box-shadow: 0 16px 44px rgba(13, 27, 39, 0.10); }
  .deliver-num { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; color: var(--posText); }
  .deliver-card h3 { margin: 0; font-size: 1.21875rem; font-weight: 700; letter-spacing: -0.015em; }
  .deliver-card p { margin: 0; font-size: 0.9375rem; line-height: 1.65; color: var(--muted); }

  /* ---------- Aanpak ---------- */
  .approach { background: var(--bg); border-top: 1px solid var(--line); scroll-margin-top: 80px; }
  .approach-wrap { padding-top: 84px; padding-bottom: 84px; }
  .approach h2 { margin-bottom: 14px; }
  .approach-sub { margin: 0 0 46px; max-width: 640px; font-size: 1.09375rem; line-height: 1.7; color: var(--muted); }
  .approach-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 16px; }
  .approach-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px;
    display: grid;
    gap: 9px;
    align-content: start;
  }
  .approach-num { font-size: 2rem; font-weight: 300; line-height: 1; color: var(--hl); }
  .approach-card h3 { margin: 0; font-size: 1.15625rem; font-weight: 700; }
  .approach-card p { margin: 0; font-size: 0.90625rem; line-height: 1.6; color: var(--muted); }

  /* ---------- Resultaat ---------- */
  .results { position: relative; overflow: hidden; background: var(--brand); color: var(--bg); }
  .results-nebula {
    position: absolute;
    left: -140px;
    bottom: -220px;
    filter: blur(120px) saturate(1.1);
    opacity: 0.32;
    --logoBase: transparent;
    --logoBovenA: #FF301D; --logoBovenB: #FF301D;
    --logoOnderA: #1B5FB3; --logoOnderB: #1B5FB3;
    --logoRechtsA: #4DCBC9; --logoRechtsB: #4DCBC9;
  }
  .results-wrap { position: relative; padding-top: 84px; padding-bottom: 84px; }
  .results-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr)); gap: 32px; }
  .result { display: grid; gap: 9px; align-content: start; }
  .result-stat {
    margin: 0;
    font-size: clamp(2.125rem, 3.4vw, 2.75rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--teal);
  }
  .result h3 { margin: 0; font-size: 1.09375rem; font-weight: 700; }
  .result-body { margin: 0; font-size: 0.90625rem; line-height: 1.6; color: color-mix(in srgb, var(--bg) 68%, transparent); }

  /* ---------- Combineert met ---------- */
  .related { background: #ffffff; }
  .related-wrap { padding-top: 80px; padding-bottom: 80px; }
  .related h2 { margin: 0 0 12px; font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1.15; letter-spacing: -0.025em; }
  .related-sub { margin: 0 0 34px; max-width: 600px; font-size: 1.0625rem; line-height: 1.7; color: var(--muted); }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 16px; }
  .related-card {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 24px;
    display: grid;
    gap: 8px;
    align-content: start;
    color: var(--brand);
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
  }
  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(13, 27, 39, 0.09);
    border-color: color-mix(in srgb, var(--hl) 35%, transparent);
    color: var(--brand);
  }
  .related-kind { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--posText); }
  .related-card h3 { margin: 0; font-size: 1.21875rem; font-weight: 700; letter-spacing: -0.015em; }
  .related-card p { margin: 0; font-size: 0.90625rem; line-height: 1.6; color: var(--muted); }
  .related-cta { font-size: 0.875rem; font-weight: 700; color: var(--hl); }

  /* ---------- CTA ---------- */
  .cta { background: var(--bg); border-top: 1px solid var(--line); scroll-margin-top: 72px; }
  .cta-wrap { max-width: 860px; margin: 0 auto; padding: 88px 40px; text-align: center; }
  .cta h2 { margin: 0 0 14px; max-width: none; font-size: clamp(1.875rem, 3.8vw, 2.75rem); line-height: 1.08; }
  .cta-sub { margin: 0 0 34px; font-size: 1.125rem; line-height: 1.6; color: var(--muted); }
  .cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .cta-btn { font-size: 1.09375rem; padding: 17px 40px; }
  .cta-btn2 {
    border: 1.5px solid color-mix(in srgb, var(--brand) 20%, transparent);
    color: var(--brand);
    font-weight: 600;
    font-size: 1.09375rem;
    padding: 16px 34px;
    border-radius: 99px;
  }
  .cta-btn2:hover { border-color: var(--hl); color: var(--hl); }
</style>
