---
/** About page: implementation of "Over ons.dc.html". */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  abs,
  routes,
  ui,
  CALENDLY_MEETING_URL,
  COMPANY,
  EMAIL_DAAN,
  EMAIL_JANWILLEM,
  LINKEDIN_DAAN,
  LINKEDIN_JANWILLEM,
  PHONE_DISPLAY,
  PHONE_TEL,
  type Lang,
} from '../../lib/site';
import daanPhoto from '../../assets/daan.jpeg';
import janWillemPhoto from '../../assets/jan-willem.jpeg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other: Lang = lang === 'nl' ? 'en' : 'nl';

const nl = {
  metaTitle: 'Over ons, twee consultants uit de praktijk',
  metaDescription:
    'DataFlowr is opgericht door Daan Jansen (financial control & consultancy) en Jan-Willem Gmelig Meyling (solution architect & software engineer). Samen één doel: bedrijven efficiënter laten werken door financiële automatisering.',
  eyebrow: 'Over ons',
  title: 'Twee consultants uit de praktijk.',
  intro:
    'Allebei een andere achtergrond, samen de perfecte match. Ontmoet in de consultancy, krachten gebundeld in 2025 · met één doel: bedrijven efficiënter laten werken door financiële automatisering.',
  daanRole: 'Co-founder · Financial Consultant',
  daanBio:
    'Achtergrond in financial control en consultancy. Kent financiële processen, rapportage-eisen en governance van binnenuit, en weet precies waar het knelt in closing, facturatie en reconciliatie.',
  daanSlot: 'Portret van Daan Jansen',
  jwRole: 'Co-founder · Solution Architect',
  jwBio:
    'Solution architect en software engineer. Bouwt integraties, workflows en AI-oplossingen, met ervaring in het opschalen van development teams en tech-gedreven transformaties.',
  jwSlot: 'Portret van Jan-Willem Gmelig Meyling',
  partnersTitle: 'Partnerstatus',
  partners: [
    {
      name: 'Exact Online Premium Partner',
      body: 'Formeel partner van Exact. Wij implementeren en beheren Exact Online Premium en werken met de Premium-API’s, Smart Closing en de Power BI Connector.',
    },
    {
      name: 'Microsoft AI Cloud Partner',
      body: 'Formeel partner van Microsoft. Relevant voor Claire, die naast Claude en ChatGPT ook in Microsoft 365 Copilot werkt.',
    },
  ],
  calendlyTitle: 'Plan direct een kennismaking',
  calendlyIntro:
    'Benieuwd wat we voor uw organisatie kunnen betekenen? Kies een moment dat u schikt, dan zorgen wij voor de rest. Een kennismaking duurt 30 minuten en is geheel vrijblijvend.',
  calendlyFallback: 'Laadt de agenda niet? Open hem in een nieuw tabblad, bel ons, of mail een van ons rechtstreeks.',
  calendlyFallbackCta: 'Open de agenda',
  detailsTitle: 'Bedrijfsgegevens',
  detailsAddress: 'Vestigingsadres',
  detailsPhone: 'Telefoon',
  detailsKvk: 'KVK-nummer',
  detailsBranch: 'Vestigingsnummer',
};

const en: typeof nl = {
  metaTitle: 'About us, two consultants from practice',
  metaDescription:
    'DataFlowr was founded by Daan Jansen (financial control & consultancy) and Jan-Willem Gmelig Meyling (solution architect & software engineer). One shared goal: helping companies work more efficiently through financial automation.',
  eyebrow: 'About us',
  title: 'Two consultants from practice.',
  intro:
    'Different backgrounds, together the perfect match. We met in consultancy and joined forces in 2025 · with one goal: helping companies work more efficiently through financial automation.',
  daanRole: 'Co-founder · Financial Consultant',
  daanBio:
    'Background in financial control and consultancy. Knows financial processes, reporting requirements and governance from the inside, and knows exactly where it pinches in closing, invoicing and reconciliation.',
  daanSlot: 'Portrait of Daan Jansen',
  jwRole: 'Co-founder · Solution Architect',
  jwBio:
    'Solution architect and software engineer. Builds integrations, workflows and AI solutions, with experience scaling development teams and tech-driven transformations.',
  jwSlot: 'Portrait of Jan-Willem Gmelig Meyling',
  partnersTitle: 'Partner status',
  partners: [
    {
      name: 'Exact Online Premium Partner',
      body: 'A formal Exact partner. We implement and manage Exact Online Premium and work with the Premium APIs, Smart Closing and the Power BI Connector.',
    },
    {
      name: 'Microsoft AI Cloud Partner',
      body: 'A formal Microsoft partner. Relevant to Claire, which works in Microsoft 365 Copilot alongside Claude and ChatGPT.',
    },
  ],
  calendlyTitle: 'Book an intro call directly',
  calendlyIntro:
    'Curious what we could mean for your organisation? Pick a time that suits you and we will take care of the rest. An intro call takes 30 minutes and is entirely without obligation.',
  calendlyFallback: 'Calendar not loading? Open it in a new tab, call us, or email one of us directly.',
  calendlyFallbackCta: 'Open the calendar',
  detailsTitle: 'Company details',
  detailsAddress: 'Registered address',
  detailsPhone: 'Phone',
  detailsKvk: 'Chamber of Commerce (KVK)',
  detailsBranch: 'Branch number',
};

const t = lang === 'nl' ? nl : en;
const calendlyEmbedUrl = `${CALENDLY_MEETING_URL}?hide_gdpr_banner=1&primary_color=1B5FB3`;
const path = routes.about[lang];
const altPath = routes.about[other];

const schema = [
  {
    '@type': 'AboutPage',
    '@id': abs(`${path}#page`),
    url: abs(path),
    name: t.metaTitle,
    description: t.metaDescription,
    about: { '@id': abs('/#organization') },
  },
];
---
<BaseLayout
  lang={lang}
  title={t.metaTitle}
  description={t.metaDescription}
  path={path}
  altPath={altPath}
  navVariant="solid"
  ctaHref="#plan-afspraak"
  footer="compact-bg"
  schema={schema}
>
  <section class="wrap about">
    <p class="eyebrow eyebrow--thin about-eyebrow">{t.eyebrow}</p>
    <h1>{t.title}</h1>
    <p class="intro">{t.intro}</p>
    <div class="founders">
      <div class="founder">
        <div class="founder-photo">
          <Image src={daanPhoto} alt={t.daanSlot} width={236} height={236} class="founder-img" />
        </div>
        <div class="founder-body">
          <h2>Daan Jansen</h2>
          <p class="founder-role">{t.daanRole}</p>
          <p class="founder-bio">{t.daanBio}</p>
          <a href={`mailto:${EMAIL_DAAN}`} class="founder-mail">{EMAIL_DAAN}</a>
          <a href={LINKEDIN_DAAN} class="founder-linkedin" target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
      <div class="founder">
        <div class="founder-photo">
          <Image src={janWillemPhoto} alt={t.jwSlot} width={236} height={236} class="founder-img" />
        </div>
        <div class="founder-body">
          <h2>Jan-Willem Gmelig Meyling</h2>
          <p class="founder-role">{t.jwRole}</p>
          <p class="founder-bio">{t.jwBio}</p>
          <a href={`mailto:${EMAIL_JANWILLEM}`} class="founder-mail">{EMAIL_JANWILLEM}</a>
          <a href={LINKEDIN_JANWILLEM} class="founder-linkedin" target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </div>
    <div class="partners">
      <h2>{t.partnersTitle}</h2>
      <ul>
        {t.partners.map((partner) => (
          <li>
            <span class="partner-name">{partner.name}</span>
            <span class="partner-body">{partner.body}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="calendly" id="plan-afspraak">
      <h2>{t.calendlyTitle}</h2>
      <p>{t.calendlyIntro}</p>
      {/* widget.js appends its spinner and iframe to this container without
          clearing it, and it stamps data-processed on the way in. That attribute
          is the hook the styles below use: with it the container takes the
          Calendly height and the fallback is hidden, without it the container
          stays auto-height and the fallback is what the reader sees. A blocked
          script therefore leaves working contact details rather than an empty
          700px box. */}
      <div class="calendly-inline-widget" data-url={calendlyEmbedUrl}>
        <div class="calendly-fallback">
          <p>{t.calendlyFallback}</p>
          <p class="calendly-fallback-links">
            <a href={CALENDLY_MEETING_URL} target="_blank" rel="noopener">{t.calendlyFallbackCta}</a>
            <a href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY[lang]}</a>
            <a href={`mailto:${EMAIL_DAAN}`}>{EMAIL_DAAN}</a>
            <a href={`mailto:${EMAIL_JANWILLEM}`}>{EMAIL_JANWILLEM}</a>
          </p>
        </div>
      </div>
      <script is:inline type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
    </div>
    <div class="company-details">
      <h2>{t.detailsTitle}</h2>
      <dl>
        <div>
          <dt>{t.detailsAddress}</dt>
          <dd>{COMPANY.legalName}<br />{COMPANY.street}<br />{COMPANY.postalCode} {COMPANY.city}</dd>
        </div>
        <div>
          <dt>{t.detailsPhone}</dt>
          <dd><a href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY[lang]}</a></dd>
        </div>
        <div>
          <dt>{t.detailsKvk}</dt>
          <dd>{COMPANY.kvk}</dd>
        </div>
        <div>
          <dt>{t.detailsBranch}</dt>
          <dd>{COMPANY.vestigingsnummer}</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .about { padding-top: 96px; padding-bottom: 110px; }
  .about-eyebrow { color: color-mix(in srgb, var(--hl) 85%, var(--brand)); margin-bottom: 18px; gap: 14px; }
  h1 {
    margin: 0 0 22px;
    font-size: clamp(2.5rem, 4.5vw, 3.625rem);
    line-height: 1.06;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .intro { margin: 0 0 56px; max-width: 720px; font-size: 1.125rem; line-height: 1.7; color: var(--muted); text-wrap: pretty; }
  .founders { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr)); gap: 20px; }
  .founder {
    background: #ffffff;
    border: 1px solid color-mix(in srgb, var(--brand) 9%, transparent);
    border-radius: 20px;
    padding: 30px;
    display: flex;
    gap: 24px;
    align-items: flex-start;
    transition: transform 0.35s, box-shadow 0.35s;
  }
  .founder:hover { transform: translateY(-3px); box-shadow: 0 18px 50px color-mix(in srgb, var(--brand) 10%, transparent); }
  .founder-photo { flex: none; width: 118px; }
  .founder-img {
    display: block;
    width: 118px;
    height: 148px;
    object-fit: cover;
    border-radius: 14px;
  }
  .founder-body { min-width: 0; }
  .founder h2 { margin: 0 0 4px; font-size: 1.25rem; font-weight: 700; }
  .founder-role {
    margin: 0 0 12px;
    font-size: 0.78125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--hl) 85%, var(--brand));
  }
  .founder-bio { margin: 0 0 14px; font-size: 1rem; line-height: 1.65; color: var(--muted); }
  /* The address is one unbreakable word next to a 118px portrait, so on a
     narrow phone it has to be allowed to break or the page scrolls sideways. */
  .founder-mail { font-size: 0.90625rem; font-weight: 700; overflow-wrap: anywhere; }
  .founder-linkedin { margin-left: 16px; font-size: 0.90625rem; font-weight: 700; }
  .partners { display: grid; gap: 16px; }
  .partners h2 { margin: 0; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; }
  .partners ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); }
  .partners li {
    display: grid;
    gap: 6px;
    padding: 22px 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .partner-name { font-size: 1.0625rem; font-weight: 700; letter-spacing: -0.015em; }
  .partner-body { font-size: 0.96875rem; line-height: 1.6; color: var(--muted); }

  .calendly {
    margin-top: 64px;
    padding-top: 44px;
    border-top: 1px solid color-mix(in srgb, var(--brand) 9%, transparent);
    scroll-margin-top: 96px;
  }
  .calendly h2, .company-details h2 { margin: 0 0 10px; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; }
  .calendly > p { margin: 0; max-width: 620px; font-size: 1.03125rem; line-height: 1.65; color: var(--muted); text-wrap: pretty; }
  .calendly-inline-widget { margin-top: 8px; min-width: 320px; }
  .calendly-inline-widget[data-processed] { height: 700px; }
  .calendly-inline-widget[data-processed] .calendly-fallback { display: none; }
  .calendly-fallback {
    display: grid;
    gap: 10px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #ffffff;
  }
  .calendly-fallback p { margin: 0; font-size: 0.96875rem; line-height: 1.6; color: var(--muted); }
  .calendly-fallback-links { display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .calendly-fallback-links a { color: var(--hl); font-weight: 600; }
  .company-details {
    margin-top: 64px;
    padding-top: 44px;
    border-top: 1px solid color-mix(in srgb, var(--brand) 9%, transparent);
  }
  .company-details dl { margin: 0; display: flex; flex-wrap: wrap; gap: 28px 64px; }
  .company-details dt {
    margin: 0 0 6px;
    font-size: 0.78125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--hl) 85%, var(--brand));
  }
  .company-details dd { margin: 0; font-size: 1rem; line-height: 1.65; color: var(--muted); }
</style>
