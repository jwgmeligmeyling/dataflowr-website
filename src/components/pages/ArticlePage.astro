---
/**
 * Knowledge-base article page — implementation of "Artikel.dc.html".
 * Generic template: content comes from src/data/articles.ts, the TOC is
 * derived from the h2 blocks and the "more" cards from the other articles.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClaireMark from '../ClaireMark.astro';
import { abs, routes, ui, type ArticleKey, type Lang } from '../../lib/site';
import { articles, articleUi, authors } from '../../data/articles';

interface Props {
  lang: Lang;
  articleKey: ArticleKey;
}
const { lang, articleKey } = Astro.props;
const other: Lang = lang === 'nl' ? 'en' : 'nl';

const article = articles[articleKey];
const t = article[lang];
const s = articleUi[lang];
const author = authors[article.author];

const path = routes.articles[articleKey][lang];
const altPath = routes.articles[articleKey][other];
const toc = t.blocks.filter((block) => block.type === 'h2');

const more = (Object.keys(articles) as ArticleKey[])
  .filter((key) => key !== articleKey)
  .map((key) => ({
    href: routes.articles[key][lang],
    cat: articles[key][lang].cat,
    title: articles[key][lang].title,
    time: articles[key][lang].readTime,
    hero: articles[key][lang].hero,
  }));

const schema = [
  {
    '@type': 'Article',
    '@id': abs(`${path}#article`),
    headline: t.title,
    description: t.metaDescription,
    image: abs(t.hero.src),
    datePublished: article.dateIso,
    inLanguage: lang === 'nl' ? 'nl-NL' : 'en',
    mainEntityOfPage: abs(path),
    author: { '@type': 'Person', name: author.name, jobTitle: author.jobTitle, email: `mailto:${author.email}` },
    publisher: { '@id': abs('/#organization') },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui[lang].home, item: abs(routes.home[lang]) },
      { '@type': 'ListItem', position: 2, name: s.crumbResources },
      { '@type': 'ListItem', position: 3, name: t.crumbCurrent, item: abs(path) },
    ],
  },
];
---
<BaseLayout
  lang={lang}
  title={t.metaTitle}
  description={t.metaDescription}
  path={path}
  altPath={altPath}
  navVariant="solid"
  ctaHref={`mailto:${author.email}`}
  footer="compact-white"
  ogType="article"
  ogImage={{ src: t.hero.src, width: 2880, height: 1620 }}
  schema={schema}
>
  <div class="page">
    <article class="wrap article">
      <nav aria-label={lang === 'nl' ? 'Kruimelpad' : 'Breadcrumb'} class="crumbs">
        <a href={routes.home[lang]}>{ui[lang].home}</a><span>/</span>
        <a href={routes.article[lang]}>{s.crumbResources}</a><span>/</span>
        <span class="crumb-current">{t.crumbCurrent}</span>
      </nav>
      <div class="grid">
        <div class="body">
          <div class="meta">
            <span class="tag">{t.tag}</span>
            <span class="date"><time datetime={article.dateIso}>{t.date}</time> · {t.readTime}</span>
          </div>
          <h1>{t.title}</h1>
          <p class="lead">{t.lead}</p>

          <div class="hero-media">
            <img src={t.hero.src} alt={t.hero.alt} width="2880" height="1620" />
          </div>

          {t.blocks.map((block) => {
            if (block.type === 'p') return <p>{block.text}</p>;
            if (block.type === 'h2') return <h2 id={block.id}>{block.text}</h2>;
            if (block.type === 'quote')
              return (
                <blockquote>
                  <p>{block.text}</p>
                </blockquote>
              );
            return (
              <ol>
                {block.items.map((item) => <li><strong>{item.strong}</strong>{item.rest}</li>)}
              </ol>
            );
          })}

          <div class="author">
            <div class="author-photo">
              <Image src={author.photo} alt={`${s.authorSlot} ${author.name}`} width={112} height={112} class="author-img" />
            </div>
            <div class="author-id">
              <p class="author-name">{author.name}</p>
              <p class="author-role">{author.role[lang]}</p>
            </div>
            <a href={`mailto:${author.email}`} class="author-cta">{s.authorCta}</a>
          </div>
        </div>

        <aside class="sidebar">
          <div class="toc">
            <p class="toc-title">{s.tocTitle}</p>
            <nav>
              {toc.map((item) => <a href={`#${item.id}`}>{item.text}</a>)}
            </nav>
          </div>
          <div class="claire-promo">
            <span class="claire-badge" aria-hidden="true"><ClaireMark size={38} /></span>
            <h3>{t.claireTitle}</h3>
            <p>{t.claireBody}</p>
            <a href={routes.claire[lang]}>{s.claireCta}</a>
          </div>
        </aside>
      </div>
    </article>

    <section class="more">
      <div class="wrap more-inner">
        <h2>{s.moreTitle}</h2>
        <div class="more-grid">
          {more.map((post) => (
            <a href={post.href} class="more-card">
              <div class="more-media"><img src={post.hero.src} alt="" loading="lazy" width="2880" height="1620" /></div>
              <div class="more-body">
                <span class="more-cat">{post.cat}</span>
                <h3>{post.title}</h3>
                <span class="more-time">{post.time}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page { background: #ffffff; }
  .article { padding-top: 56px; }
  .crumbs { display: flex; align-items: center; gap: 10px; margin-bottom: 34px; font-size: 12.5px; color: var(--muted); }
  .crumb-current { color: var(--brand); font-weight: 600; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 720px) minmax(0, 300px);
    gap: 64px;
    justify-content: center;
    align-items: start;
  }
  @media (max-width: 1040px) {
    .grid { grid-template-columns: minmax(0, 720px); }
    .sidebar { position: static !important; }
  }
  .body { min-width: 0; }
  .meta { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; flex-wrap: wrap; }
  .tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hl);
    background: color-mix(in srgb, var(--hl) 9%, transparent);
    border-radius: 99px;
    padding: 6px 13px;
  }
  .date { font-size: 12.5px; color: var(--muted); }
  h1 {
    margin: 0 0 22px;
    font-size: clamp(34px, 4.2vw, 52px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .lead { margin: 0 0 34px; font-size: 19px; line-height: 1.65; font-weight: 400; color: var(--muted); text-wrap: pretty; }
  .hero-media { margin: 0 0 40px; border-radius: 16px; overflow: hidden; aspect-ratio: 16 / 9; background: var(--bg); border: 1px solid var(--line); }
  .hero-media img, .more-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .body > p { margin: 0 0 24px; font-size: 16.5px; line-height: 1.8; color: var(--brand); }
  .body h2 {
    margin: 44px 0 16px;
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.025em;
    scroll-margin-top: 96px;
  }
  blockquote { margin: 34px 0; padding: 26px 30px; background: var(--bg); border-radius: 16px; }
  blockquote p {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--brand);
    text-wrap: pretty;
  }
  ol { margin: 0 0 28px; padding-left: 22px; display: grid; gap: 14px; }
  ol li { font-size: 16.5px; line-height: 1.75; color: var(--brand); }
  ol strong { font-weight: 700; }
  .author {
    margin: 44px 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 18px;
    align-items: center;
    flex-wrap: wrap;
  }
  .author-photo { flex: none; width: 56px; height: 56px; border-radius: 50%; overflow: hidden; background: var(--bg); }
  .author-img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .author-id { min-width: 0; }
  .author-name { margin: 0 0 2px; font-size: 14.5px; font-weight: 700; }
  .author-role { margin: 0; font-size: 13px; color: var(--muted); }
  .author-cta { margin-left: auto; font-size: 13.5px; font-weight: 700; }

  .sidebar { display: grid; gap: 18px; position: sticky; top: 104px; }
  .toc { border: 1px solid var(--line); border-radius: 16px; padding: 22px; }
  .toc-title {
    margin: 0 0 14px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .toc nav { display: grid; gap: 10px; }
  .toc a { font-size: 13.5px; line-height: 1.5; color: var(--muted); }
  .toc a:hover { color: var(--hl); }
  .claire-promo { border-radius: 16px; padding: 24px; background: var(--brand); color: var(--bg); }
  .claire-badge {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-bottom: 14px;
  }
  .claire-promo h3 { margin: 0 0 8px; font-size: 17px; font-weight: 700; letter-spacing: -0.015em; }
  .claire-promo p { margin: 0 0 18px; font-size: 13.5px; line-height: 1.6; color: color-mix(in srgb, var(--bg) 72%, transparent); }
  .claire-promo a {
    display: inline-block;
    background: var(--hl);
    color: #fff;
    font-weight: 700;
    font-size: 13.5px;
    padding: 11px 20px;
    border-radius: 99px;
  }
  .claire-promo a:hover { background: #164E93; color: #fff; }

  .more { margin-top: 80px; background: var(--bg); border-top: 1px solid var(--line); }
  .more-inner { padding-top: 72px; padding-bottom: 72px; }
  .more h2 { margin: 0 0 34px; font-size: clamp(24px, 2.6vw, 32px); line-height: 1.15; font-weight: 700; letter-spacing: -0.025em; }
  .more-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 18px; }
  .more-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    display: grid;
    color: var(--brand);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .more-card:hover { transform: translateY(-3px); box-shadow: 0 16px 44px rgba(13, 27, 39, 0.10); color: var(--brand); }
  .more-media { aspect-ratio: 16 / 9; background: var(--bg); }
  .more-body { padding: 22px; display: grid; gap: 8px; }
  .more-cat { font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--posText); }
  .more-card h3 { margin: 0; font-size: 17px; line-height: 1.3; font-weight: 700; letter-spacing: -0.015em; }
  .more-time { font-size: 12.5px; color: var(--muted); }
</style>
