---
/**
 * Documentation page. Generic template: content comes from src/data/docs.ts,
 * the TOC is derived from the h2 blocks and the previous/next links follow
 * the route-table order. Layout mirrors ArticlePage, without author or hero.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { abs, routes, ui, type DocKey, type Lang } from '../../lib/site';
import { docOrder, docs, docsUi, type DocBlock } from '../../data/docs';

interface Props {
  lang: Lang;
  docKey: DocKey;
}
const { lang, docKey } = Astro.props;
const other: Lang = lang === 'nl' ? 'en' : 'nl';

const doc = docs[docKey];
const t = doc[lang];
const s = docsUi[lang];

const path = routes.docPages[docKey][lang];
const altPath = routes.docPages[docKey][other];
const toc = t.blocks.filter((block) => block.type === 'h2');

const position = docOrder.indexOf(docKey);
const prevKey = position > 0 ? docOrder[position - 1] : null;
const nextKey = position < docOrder.length - 1 ? docOrder[position + 1] : null;
const prev = prevKey && { href: routes.docPages[prevKey][lang], title: docs[prevKey][lang].title };
const next = nextKey && { href: routes.docPages[nextKey][lang], title: docs[nextKey][lang].title };

/** Split "text with [label](href)" into renderable segments. */
type Segment = { link: false; text: string } | { link: true; text: string; href: string };
const inline = (text: string): Segment[] => {
  const segments: Segment[] = [];
  const pattern = /\[([^\]]+)\]\(([^)\s]+)\)/g;
  let cursor = 0;
  for (const match of text.matchAll(pattern)) {
    if (match.index > cursor) segments.push({ link: false, text: text.slice(cursor, match.index) });
    segments.push({ link: true, text: match[1], href: match[2] });
    cursor = match.index + match[0].length;
  }
  if (cursor < text.length) segments.push({ link: false, text: text.slice(cursor) });
  return segments;
};

const blocks: DocBlock[] = t.blocks;

const schema = [
  {
    '@type': 'TechArticle',
    '@id': abs(`${path}#doc`),
    headline: t.title,
    description: t.metaDescription,
    inLanguage: lang === 'nl' ? 'nl-NL' : 'en',
    mainEntityOfPage: abs(path),
    isPartOf: { '@id': abs(`${routes.docs[lang]}#collection`) },
    publisher: { '@id': abs('/#organization') },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui[lang].home, item: abs(routes.home[lang]) },
      { '@type': 'ListItem', position: 2, name: s.crumbDocs, item: abs(routes.docs[lang]) },
      { '@type': 'ListItem', position: 3, name: t.crumbCurrent, item: abs(path) },
    ],
  },
];
---
<BaseLayout
  lang={lang}
  title={t.metaTitle}
  description={t.metaDescription}
  path={path}
  altPath={altPath}
  navVariant="solid"
  footer="compact-white"
  schema={schema}
>
  <div class="page">
    <article class="wrap doc">
      <nav aria-label={lang === 'nl' ? 'Kruimelpad' : 'Breadcrumb'} class="crumbs">
        <a href={routes.home[lang]}>{ui[lang].home}</a><span>/</span>
        <a href={routes.docs[lang]}>{s.crumbDocs}</a><span>/</span>
        <span class="crumb-current">{t.crumbCurrent}</span>
      </nav>
      <div class="grid">
        <div class="body">
          <div class="meta">
            <span class="tag">{s.groups[doc.group]}</span>
          </div>
          <h1>{t.title}</h1>
          <p class="lead">{t.lead}</p>

          {blocks.map((block) => {
            if (block.type === 'p')
              return (
                <p>
                  {inline(block.text).map((seg) => (seg.link ? <a href={seg.href}>{seg.text}</a> : seg.text))}
                </p>
              );
            if (block.type === 'h2') return <h2 id={block.id}>{block.text}</h2>;
            if (block.type === 'ul')
              return (
                <ul class="list">
                  {block.items.map((item) => (
                    <li>
                      <span class="dot-mark" aria-hidden="true"></span>
                      <span>{inline(item).map((seg) => (seg.link ? <a href={seg.href}>{seg.text}</a> : seg.text))}</span>
                    </li>
                  ))}
                </ul>
              );
            if (block.type === 'steps')
              return (
                <ol class="steps">
                  {block.items.map((item) => (
                    <li>
                      <strong>{item.strong}</strong>
                      {inline(item.rest).map((seg) => (seg.link ? <a href={seg.href}>{seg.text}</a> : seg.text))}
                    </li>
                  ))}
                </ol>
              );
            if (block.type === 'note')
              return (
                <aside class="note">
                  <p>{inline(block.text).map((seg) => (seg.link ? <a href={seg.href}>{seg.text}</a> : seg.text))}</p>
                </aside>
              );
            return (
              <div class="addr">
                <span class="addr-label">{block.label}</span>
                <code>{block.text}</code>
              </div>
            );
          })}

          <nav class="pager" aria-label={lang === 'nl' ? 'Documentatie-navigatie' : 'Documentation navigation'}>
            {prev ? (
              <a href={prev.href} class="pager-link pager-prev">
                <span class="pager-dir">{s.prev}</span>
                <span class="pager-title">{prev.title}</span>
              </a>
            ) : (
              <span></span>
            )}
            {next && (
              <a href={next.href} class="pager-link pager-next">
                <span class="pager-dir">{s.next}</span>
                <span class="pager-title">{next.title}</span>
              </a>
            )}
          </nav>
        </div>

        <aside class="sidebar">
          <div class="toc">
            <p class="toc-title">{s.tocTitle}</p>
            <nav>
              {toc.map((item) => <a href={`#${item.id}`}>{item.text}</a>)}
            </nav>
          </div>
          <div class="help">
            <h3>{s.supportTitle}</h3>
            <p>{s.supportBody}</p>
            <a href={routes.support[lang]}>{s.supportCta}</a>
          </div>
        </aside>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .page { background: #ffffff; }
  .doc { padding-top: 56px; padding-bottom: 88px; }
  .crumbs { display: flex; align-items: center; gap: 10px; margin-bottom: 34px; font-size: 0.84375rem; color: var(--muted); }
  .crumb-current { color: var(--brand); font-weight: 600; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 720px) minmax(0, 300px);
    gap: 64px;
    justify-content: center;
    align-items: start;
  }
  @media (max-width: 1040px) {
    .grid { grid-template-columns: minmax(0, 720px); }
    .sidebar { position: static !important; }
  }
  .body { min-width: 0; }
  .meta { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; flex-wrap: wrap; }
  .tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hl);
    background: color-mix(in srgb, var(--hl) 9%, transparent);
    border-radius: 99px;
    padding: 6px 13px;
  }
  h1 {
    margin: 0 0 22px;
    font-size: clamp(2.125rem, 4.2vw, 3.25rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .lead { margin: 0 0 34px; font-size: 1.28125rem; line-height: 1.65; font-weight: 400; color: var(--muted); text-wrap: pretty; }
  .body > p { margin: 0 0 24px; font-size: 1.125rem; line-height: 1.8; color: var(--brand); }
  .body h2 {
    margin: 44px 0 16px;
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.025em;
    scroll-margin-top: 96px;
  }
  .steps { margin: 0 0 28px; padding-left: 22px; display: grid; gap: 14px; }
  .steps li { font-size: 1.125rem; line-height: 1.75; color: var(--brand); }
  .steps strong { font-weight: 700; }
  .list { margin: 0 0 28px; padding: 0; list-style: none; display: grid; gap: 12px; }
  .list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: baseline;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--brand);
  }
  .dot-mark {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--hl) 85%, var(--brand));
    transform: translateY(-1px);
  }
  .note { margin: 34px 0; padding: 22px 26px; background: var(--bg); border-radius: 16px; }
  .note p { margin: 0; font-size: 1rem; line-height: 1.7; color: var(--brand); text-wrap: pretty; }
  .addr {
    margin: 0 0 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 20px;
    display: grid;
    gap: 6px;
  }
  .addr-label {
    font-size: 0.71875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .addr code { font-size: 1.03125rem; overflow-wrap: anywhere; color: var(--brand); }
  .body a { color: var(--hl); font-weight: 600; }

  .pager {
    margin-top: 52px;
    padding-top: 30px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
  }
  .pager-link { display: grid; gap: 4px; color: var(--brand); max-width: 46%; }
  .pager-next { text-align: right; margin-left: auto; }
  .pager-dir { font-size: 0.84375rem; font-weight: 600; color: var(--hl); }
  .pager-title { font-size: 0.96875rem; font-weight: 600; line-height: 1.4; }
  .pager-link:hover .pager-title { color: var(--hl); }

  .sidebar { display: grid; gap: 18px; position: sticky; top: 104px; }
  .toc { border: 1px solid var(--line); border-radius: 16px; padding: 22px; }
  .toc-title {
    margin: 0 0 14px;
    font-size: 0.71875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .toc nav { display: grid; gap: 10px; }
  .toc a { font-size: 0.90625rem; line-height: 1.5; color: var(--muted); }
  .toc a:hover { color: var(--hl); }
  .help { border-radius: 16px; padding: 24px; background: var(--brand); color: var(--bg); }
  .help h3 { margin: 0 0 8px; font-size: 1.15625rem; font-weight: 700; letter-spacing: -0.015em; }
  .help p { margin: 0 0 18px; font-size: 0.90625rem; line-height: 1.6; color: color-mix(in srgb, var(--bg) 72%, transparent); }
  .help a {
    display: inline-block;
    background: var(--hl);
    color: #fff;
    font-weight: 700;
    font-size: 0.90625rem;
    padding: 11px 20px;
    border-radius: 99px;
  }
  .help a:hover { background: #164E93; color: #fff; }
</style>
