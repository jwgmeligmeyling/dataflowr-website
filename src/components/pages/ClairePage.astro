    { kicker: '04 · YOU DECIDE', title: 'Review', body: 'You review each finding; corrections only happen after your approval.' },
  ],
  secEyebrow: 'Security & control',
  secTitle: 'A managed product, not loose scripts.',
  secCardTitle: 'Read freely, write on approval',
  secCardBody:
    'Claire reads and calculates on her own, but never writes unprompted: every change waits as a proposal for your explicit approval.',
  secProposalLabel: 'Proposal · waiting for your approval',
  secProposalBody: 'Send payment reminder, Van Dijk Techniek · VK-2026-167 · €18,200',
  secApprove: '✓ Approve',
  secNotNow: 'Not now',
  secItems: [
    { title: 'Access per user', body: 'Everyone connects with their own Exact Online account and can do exactly what they may there, nothing more. Every action is logged under their name.' },
    { title: 'No shadow copy', body: 'Your data stays in Exact Online. Claire fetches only what a given answer needs; no copy of your books ends up in an external platform.' },
    { title: 'Maintenance is our job', body: 'Changes to the Exact Online API and new features are our problem, not yours. A centrally managed service with a stable interface.' },
  ],
  obEyebrow: 'Get started',
  obTitle: 'Live in three clicks.',
  obSub:
    'No implementation project. Your intent travels with you through sign-in, so you land right back where you were. Click through the flow below.',
  obSteps: ['Connect', 'Sign in', 'Consent', 'Done'],
  obUrls: ['dataflowr.nl/claire', 'dataflowr.nl/login?returnTo=%2Fclaire%2Fstart', 'dataflowr.nl/claire/start', 'dataflowr.nl/claire/chat'],
  ob1Title: 'Connect Exact Online to Claire',
  ob1Body: 'One button, no detours. The connection starts right away; registration happens along the way, in the same step.',
  ob1Btn: 'Connect Exact Online →',
  ob1Checks: ['Free to start', 'Ready in 2 minutes', 'Claire posts nothing without your approval'],
  ob2Title: 'One more step: sign in to connect Exact Online',
  ob2Body: 'Your account keeps the connection and your conversations. Registration happens in the same step; afterwards you return straight to this connection.',
  ob2ContinuePre: 'You are continuing with: ',
  ob2ContinueStrong: 'connecting Exact Online to Claire',
  ob2Btn: 'Sign in or register →',
  ob2Checks: ['No credit card', 'Claire only reads along'],
  ob3Title: 'Welcome back. Continuing where you were.',
  ob3Body: 'You are being forwarded to Exact Online to approve the connection. After that, Claire is ready for you.',
  ob3NothingPre: 'Nothing happening? ',
  ob3Btn: 'Continue to Exact Online →',
  ob4ToastTitle: 'Exact Online connected',
  ob4ToastSub: 'Acme Holding B.V. · 3 administrations found',
  ob4Title: 'What can I help you with?',
  ob4Body: 'I am reading along in Acme Nederland. Ask your question, or pick one below.',
  ob4Sug1Title: 'How is revenue doing?',
  ob4Sug1Sub: 'This month versus last month, per customer',
  ob4Sug2Title: 'Which invoices are outstanding?',
  ob4Sug2Sub: 'Open receivables, sorted by age',
  ob4Input: 'Ask Claire your question...',
  ob4Restart: '↺ Watch again',
  obFoot1: 'Secure OAuth · no shadow copy · cancel monthly',
  obFoot2: "Prefer we walk you through it? Book a 30-minute intro and we'll set it up together.",
  waysTitle: 'Three ways to put Claire to work.',
  ways: [
    { title: 'Interactive', body: 'Open your AI assistant and ask a question about your books in plain language.', quote: '"Which purchase invoices are more than 60 days overdue?"' },
    { title: 'Autonomous', body: 'An agent runs work on a schedule and only reports back when it needs you.', quote: '"Every first working day: run my close checks and send the action list."' },
    { title: 'Integrated', body: 'Use the connector in Make, n8n or Zapier as a building block in your automations.', quote: '"Check every incoming invoice and flag duplicates in #finance."' },
  ],
  ctaTitle: 'Claire can start with you next week.',
  ctaSub: "Book a 30-minute intro, you'll speak to a founder directly.",
  ctaBtn: 'Get in touch',
  ctaBtn2: 'Connect Exact Online yourself',
};

const t = lang === 'nl' ? nl : en;
const path = routes.claire[lang];
const altPath = routes.claire[other];

const schema = [
  {
    '@type': 'SoftwareApplication',
    '@id': abs(`${path}#product`),
    name: 'Claire',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: t.metaDescription,
    url: abs(path),
    publisher: { '@id': abs('/#organization') },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui[lang].home, item: abs(routes.home[lang]) },
      { '@type': 'ListItem', position: 2, name: 'Claire', item: abs(path) },
    ],
  },
];
---
<BaseLayout
  lang={lang}
  title={t.metaTitle}
  description={t.metaDescription}
  path={path}
  altPath={altPath}
  navVariant="solid"
  ctaHref="#cta"
  footer="full"
  schema={schema}
>
  <!-- ============ HERO ============ -->
  <section id="top" class="hero">
    <div class="nebula hero-nebula" aria-hidden="true"><Logo mode="mark" h={820} /></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow eyebrow--teal">{t.heroEyebrow}</p>
        <h1>{t.heroTitlePre}<span class="accent">Claire</span>{t.heroTitlePost}</h1>
        <p class="hero-lead">{t.heroLead1}<span class="hero-lead-accent">{t.heroLead2}</span></p>
        <p class="hero-sub">{t.heroSub}</p>
        <div class="hero-ctas">
          <a href={`#${startId}`} class="btn-signal hero-btn">{t.heroCta}</a>
          <a href="#cta" class="btn-ghost-dark hero-btn2">{t.heroCta2}</a>
        </div>
        <p class="hero-note">{t.heroNote1} · {t.heroNote2}</p>
      </div>

      <!-- chat demo -->
      <div class="chat" data-noselect aria-hidden="true">
        <div class="chat-head">
          <span class="chat-avatar">C<span class="chat-status"></span></span>
          <span class="chat-id"><strong>Claire</strong><span>{t.chatRole}</span></span>
          <span class="chat-live">{t.chatLive}</span>
        </div>
        <div class="chat-body">
          <div class="msg msg--user" style="animation-delay:0.2s">{t.chatQ}</div>
          <div class="msg msg--claire" style="animation-delay:1.1s">{t.chatA1a}<strong>{t.chatA1b}</strong>{t.chatA1c}</div>
          <div class="chat-work" style="animation-delay:2.1s">
            <span class="chat-work-title">{t.chatWorkTitle}</span>
            {t.chatWork.map((item) => (
              <span class="chat-work-row"><span class="wdot"></span><strong>{item}</strong><span class="chat-check">✓</span></span>
            ))}
            <span class="chat-work-row"><span class="wdot wdot--pulse"></span><strong>{t.chatWorkPending}</strong><span class="chat-pending">{t.chatWorkPendingState}</span></span>
          </div>
          <div class="msg msg--claire" style="animation-delay:3.1s">{t.chatA2}</div>
          <div class="chat-actions" style="animation-delay:3.9s">
            <span class="chat-btn-yes">{t.chatBtnYes}</span>
            <span class="chat-btn-no">{t.chatBtnNo}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AI-ASSISTENTEN ============ -->
  <section class="band">
    <div class="wrap band-inner">
      <span class="band-label">{t.bandLabel}</span>
      <span class="band-pill"><span class="band-icon" style="color:#D97757"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:block"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 13v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V5h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"></path></svg></span>Claude</span>
      <span class="band-pill"><span class="band-icon" style="color:#10A37F"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" style="display:block" role="img" xmlns="http://www.w3.org/2000/svg"><path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z"></path></svg></span>ChatGPT</span>
      <span class="band-pill"><span class="band-icon" style="color:#0078D4"><svg width="16" height="16" viewBox="0 0 28 28" style="display:block"><defs><linearGradient id="copilot-grad-1" x1="14" y1="3" x2="14" y2="25" gradientUnits="userSpaceOnUse"><stop stop-color="#70ccc4"></stop><stop offset="0.5" stop-color="#a67dd8"></stop><stop offset="1" stop-color="#e0716c"></stop></linearGradient></defs><path d="M14 3C8.477 3 4 7.477 4 13v2c0 5.523 4.477 10 10 10s10-4.477 10-10v-2c0-5.523-4.477-10-10-10z" fill="url(#copilot-grad-1)"></path><ellipse cx="10" cy="12" rx="2" ry="2.5" fill="white"></ellipse><ellipse cx="18" cy="12" rx="2" ry="2.5" fill="white"></ellipse><path d="M9 18c0 0 2 3 5 3s5-3 5-3" stroke="white" stroke-linecap="round" fill="none"></path></svg></span>Microsoft Copilot</span>
      <span class="band-note">{t.bandNote}</span>
    </div>
  </section>

  <!-- ============ UITDAGING ============ -->
  <section class="challenge">
    <div class="challenge-inner">
      <p class="eyebrow eyebrow--bare challenge-eyebrow">{t.challengeEyebrow}</p>
      <h2>{t.challengeTitle}</h2>
      <p class="challenge-body">{t.challengeBody}</p>
    </div>
  </section>

  <!-- ============ WAT CLAIRE DOET ============ -->
  <section id="wat" class="do">
    <div class="wrap do-inner">
      <div class="do-grid">
        {t.doCards.map((card) => (
          <div class="do-card">
            <span class="do-quote">{card.quote}</span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ IN DE PRAKTIJK (Q&A) ============ -->
  <section id="praktijk" class="qa">
    <div class="wrap qa-inner">
      <p class="eyebrow">{t.praktijkEyebrow}</p>
      <h2>{t.praktijkTitle}</h2>
      <p class="qa-sub">{t.praktijkSub}</p>
      <div class="qa-grid">
        {t.qaCards.map((card) => (
          <div class="qa-card">
            <span class="qa-cat">{card.cat}</span>
            <p class="qa-q"><span class="qa-caret" aria-hidden="true">›</span><span>{card.q}</span></p>
            <div class="qa-result">
              {card.tableTitle && <p class="qa-table-title">{card.tableTitle}</p>}
              <table>
                <thead>
                  <tr>{card.cols.map((c) => <th class={c.align === 'right' ? 'r' : ''}>{c.label}</th>)}</tr>
                </thead>
                <tbody>
                  {card.rows.map((row) => (
                    <tr>
                      {row.map((cell, ci) => (
                        <td class={card.cols[ci].align === 'right' ? 'r' : ''}>
                          {cell.chip ? <span class={`chip chip--${cell.chip}`}>{cell.text}</span> : cell.text}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
              {card.note && <p class="qa-note">{card.note}</p>}
            </div>
          </div>
        ))}
      </div>
      <p class="qa-disclaimer">{t.praktijkDisclaimer}</p>
    </div>
  </section>

  <!-- ============ KERNMOGELIJKHEDEN ============ -->
  <section id="mogelijkheden" class="caps">
    <div class="wrap caps-inner">
      <p class="eyebrow">{t.capsEyebrow}</p>
      <h2>{t.capsTitle}</h2>
      <p class="caps-sub">{t.capsSub}</p>
      <div class="caps-grid">
        {t.caps.map((cap) => (
          <div class="caps-card">
            <h3>{cap.title}</h3>
            <ul>
              {cap.items.map((item) => <li><span class="dot dot--teal"></span><span>{item}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ MAANDAFSLUITING ============ -->
  <section class="close">
    <div class="nebula close-nebula" aria-hidden="true"><Logo mode="mark" h={620} /></div>
    <div class="wrap close-inner">
      <p class="eyebrow eyebrow--teal">{t.closeEyebrow}</p>
      <h2>{t.closeTitle}</h2>
      <p class="close-sub">{t.closeSub}</p>
      <div class="close-grid">
        {t.closeSteps.map((step) => (
          <div class="close-card">
            <p class="close-kicker">{step.kicker}</p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ VEILIGHEID ============ -->
  <section id="veiligheid" class="sec">
    <div class="wrap sec-inner">
      <p class="eyebrow">{t.secEyebrow}</p>
      <h2>{t.secTitle}</h2>
      <div class="sec-grid">
        <div class="sec-card">
          <h3>{t.secCardTitle}</h3>
          <p>{t.secCardBody}</p>
          <div class="sec-proposal" data-noselect>
            <span class="sec-proposal-label">{t.secProposalLabel}</span>
            <p>{t.secProposalBody}</p>
            <div class="sec-proposal-btns">
              <span class="sec-approve">{t.secApprove}</span>
              <span class="sec-notnow">{t.secNotNow}</span>
            </div>
          </div>
        </div>
        <div class="sec-list">
          {t.secItems.map((item, i) => (
            <div class={`sec-item ${i < t.secItems.length - 1 ? 'sec-item--rule' : ''}`}>
              <span class="sec-check" aria-hidden="true">✓</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AAN DE SLAG (ONBOARDING) ============ -->
  <section id={startId} class="ob">
    <div class="wrap ob-inner">
      <div class="ob-head">
        <p class="eyebrow eyebrow--bare ob-eyebrow">{t.obEyebrow}</p>
        <h2>{t.obTitle}</h2>
        <p class="ob-sub">{t.obSub}</p>
      </div>
      <div class="ob-frame" data-noselect data-ob>
        <div class="ob-chrome">
          <span class="ob-lights" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="ob-url" data-ob-url>{t.obUrls[0]}</span>
          <span class="ob-chrome-spacer" aria-hidden="true"></span>
        </div>
        <div class="ob-stepper">
          {t.obSteps.map((label, i) => (
            <>
              <button data-ob-goto={i + 1} class="ob-step-btn">
                <span class="ob-step-num" data-ob-num={i + 1}>{i + 1}</span>
                <span class="ob-step-label" data-ob-label={i + 1}>{label}</span>
              </button>
              {i < 3 && <span class="ob-step-line" data-ob-line={i + 1} aria-hidden="true"></span>}
            </>
          ))}
        </div>
        <div class="ob-stage">
          <!-- Stap 1 -->
          <div data-ob-panel="1">
            <div class="ob-p1">
              <div class="ob-logos ob-logos--pop">
                <span class="ob-logo-c" aria-hidden="true">C</span>
                <span class="ob-dots" aria-hidden="true">···</span>
                <span class="ob-logo-exact" aria-hidden="true">=exact</span>
              </div>
              <h3>{t.ob1Title}</h3>
              <p>{t.ob1Body}</p>
              <button data-ob-goto="2" class="ob-primary">{t.ob1Btn}</button>
              <div class="ob-checks">
                {t.ob1Checks.map((c) => <span><span class="ob-check">✓</span>{c}</span>)}
              </div>
            </div>
          </div>
          <!-- Stap 2 -->
          <div data-ob-panel="2" hidden>
            <div class="ob-p2">
              <div class="ob-logos ob-logos--sm">
                <span class="ob-logo-c ob-logo-c--sm" aria-hidden="true">C</span>
                <span class="ob-plus" aria-hidden="true">+</span>
                <span class="ob-logo-exact ob-logo-exact--sm" aria-hidden="true">=exact</span>
              </div>
              <h3>{t.ob2Title}</h3>
              <p>{t.ob2Body}</p>
              <div class="ob-continue">
                <span>{t.ob2ContinuePre}<strong>{t.ob2ContinueStrong}</strong></span>
                <code>?returnTo=/claire/start</code>
              </div>
              <div><button data-ob-goto="3" class="ob-primary">{t.ob2Btn}</button></div>
              <div class="ob-checks ob-checks--left">
                {t.ob2Checks.map((c) => <span><span class="ob-check">✓</span>{c}</span>)}
              </div>
            </div>
          </div>
          <!-- Stap 3 -->
          <div data-ob-panel="3" hidden>
            <div class="ob-p3">
              <div class="ob-logos">
                <span class="ob-logo-c ob-logo-c--md" aria-hidden="true">C</span>
                <span class="ob-dots" aria-hidden="true">···</span>
                <span class="ob-logo-exact ob-logo-exact--md" aria-hidden="true">=exact</span>
              </div>
              <h3>{t.ob3Title}</h3>
              <p>{t.ob3Body}</p>
              <div class="ob-progress"><span data-ob-bar></span></div>
              <p class="ob-nothing">{t.ob3NothingPre}<button data-ob-goto="4" class="ob-linkbtn">{t.ob3Btn}</button></p>
            </div>
          </div>
          <!-- Stap 4 -->
          <div data-ob-panel="4" hidden>
            <div class="ob-p4-wrap">
              <div class="ob-toast">
                <span class="ob-toast-check">✓</span>
                <span class="ob-toast-body"><strong>{t.ob4ToastTitle}</strong><span>{t.ob4ToastSub}</span></span>
              </div>
              <div class="ob-p4">
                <span class="ob-logo-c" aria-hidden="true">C</span>
                <h3>{t.ob4Title}</h3>
                <p>{t.ob4Body}</p>
                <div class="ob-suggestions">
                  <span class="ob-sug"><strong>{t.ob4Sug1Title}</strong><span>{t.ob4Sug1Sub}</span></span>
                  <span class="ob-sug"><strong>{t.ob4Sug2Title}</strong><span>{t.ob4Sug2Sub}</span></span>
                </div>
                <div class="ob-input">
                  <span class="ob-input-hint">{t.ob4Input}</span>
                  <span class="ob-input-send" aria-hidden="true">→</span>
                </div>
                <button data-ob-goto="1" class="ob-restart">{t.ob4Restart}</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="ob-foot1"><span class="ob-live-dot"></span>{t.obFoot1}</p>
      <p class="ob-foot2">{t.obFoot2}</p>
    </div>
  </section>

  <!-- ============ DRIE MANIEREN ============ -->
  <section class="ways">
    <div class="wrap ways-inner">
      <h2>{t.waysTitle}</h2>
      <div class="ways-grid">
        {t.ways.map((way) => (
          <div class="way-card">
            <h3>{way.title}</h3>
            <p>{way.body}</p>
            <span class="way-quote">{way.quote}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section id="cta" class="cta">
    <div class="cta-inner">
      <span class="cta-avatar" aria-hidden="true">C<span class="cta-status"></span></span>
      <h2>{t.ctaTitle}</h2>
      <p class="cta-sub">{t.ctaSub}</p>
      <div class="cta-btns">
        <a href={`mailto:${EMAIL_DAAN}`} class="btn-signal cta-btn">{t.ctaBtn}</a>
        <a href={`#${startId}`} class="btn-ghost-dark cta-btn2">{t.ctaBtn2}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Onboarding flow stepper: staat van de 4 stappen, klikbaar door de flow.
  const frame = document.querySelector<HTMLElement>('[data-ob]');
  if (frame) {
    const urlEl = frame.querySelector<HTMLElement>('[data-ob-url]');
    const urlList = [
      'dataflowr.nl/claire',
      'dataflowr.nl/login?returnTo=%2Fclaire%2Fstart',
      'dataflowr.nl/claire/start',
      'dataflowr.nl/claire/chat',
    ];
    const setStep = (n: number) => {
      frame.querySelectorAll<HTMLElement>('[data-ob-panel]').forEach((p) => {
        const on = Number(p.dataset.obPanel) === n;
        p.hidden = !on;
        if (on) {
          // Retrigger de entree-animaties bij elke stapwissel.
          p.querySelectorAll<HTMLElement>('.ob-p1,.ob-p2,.ob-p3,.ob-p4,.ob-toast,[data-ob-bar]').forEach((el) => {
            el.style.animation = 'none';
            void el.offsetWidth;
            el.style.animation = '';
          });
        }
      });
      for (let i = 1; i <= 4; i++) {
        const num = frame.querySelector<HTMLElement>(`[data-ob-num="${i}"]`);
        const label = frame.querySelector<HTMLElement>(`[data-ob-label="${i}"]`);
        const line = frame.querySelector<HTMLElement>(`[data-ob-line="${i}"]`);
        const active = i === n;
        const done = i < n;
        if (num) {
          num.textContent = done ? '✓' : String(i);
          num.classList.toggle('is-active', active);
          num.classList.toggle('is-done', done);
        }
        label?.classList.toggle('is-active', active);
        line?.classList.toggle('is-done', done);
      }
      if (urlEl) urlEl.textContent = urlList[Math.min(n, 4) - 1];
    };
    frame.querySelectorAll<HTMLElement>('[data-ob-goto]').forEach((btn) => {
      btn.addEventListener('click', () => setStep(Number(btn.dataset.obGoto)));
    });
    setStep(1);
  }
</script>

