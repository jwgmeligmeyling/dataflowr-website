---
/** Full footer (home, Claire, service pages). Compact logo top-left per design review. */
import Logo from './Logo.astro';
import { routes, ui, LINKEDIN_URL, EMAIL_DAAN, EMAIL_JANWILLEM, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---
<footer class="site-footer">
  <div class="wrap inner">
    <div class="cols">
      <div class="col col--brand">
        <div class="lockup">
          <Logo mode="mark" h={26} />
          <span class="name">DataFlowr</span>
        </div>
        <p class="tagline">{t.footerTagline}</p>
        <p class="body">{t.footerBody}</p>
      </div>
      <div class="col">
        <p class="heading">{t.footerContact}</p>
        <div class="links">
          <a href={`mailto:${EMAIL_DAAN}`}>{EMAIL_DAAN}</a>
          <a href={`mailto:${EMAIL_JANWILLEM}`}>{EMAIL_JANWILLEM}</a>
          <a href={routes.about[lang]}>{t.cta}</a>
        </div>
      </div>
      <div class="col">
        <p class="heading">{t.footerOnline}</p>
        <div class="links">
          <a href="https://dataflowr.nl">dataflowr.nl</a>
          <a href={LINKEDIN_URL} target="_blank" rel="noopener">linkedin.com/company/dataflowr</a>
        </div>
      </div>
      <div class="col">
        <p class="heading">{t.footerMeet}</p>
        <div class="links links--plain">
          {t.footerMeetItems.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </div>
    <div class="legal">
      <span>{t.footerCopyright}</span>
      <span class="motto">{t.footerMotto}</span>
    </div>
  </div>
</footer>

<style>
  .inner { padding-top: 76px; padding-bottom: 32px; }
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    justify-content: space-between;
    padding-bottom: 60px;
  }
  .col { flex: 0 1 auto; }
  .col--brand { flex: 1 1 300px; min-width: 0; }
  .lockup { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .name { font-size: 1.28125rem; font-weight: 700; letter-spacing: -0.02em; color: var(--brand); }
  .tagline, .heading {
    margin: 0 0 12px;
    font-size: 0.71875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .heading { margin-bottom: 14px; }
  .body { margin: 0; max-width: 340px; font-size: 0.90625rem; line-height: 1.65; color: var(--muted); }
  .links { display: grid; gap: 9px; font-size: 0.9375rem; }
  .links--plain { color: var(--muted); }
  .legal {
    border-top: 1px solid color-mix(in srgb, var(--brand) 9%, transparent);
    padding-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    align-items: center;
    font-size: 0.84375rem;
    color: var(--muted);
  }
  .motto { font-size: 0.75rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; }
</style>
