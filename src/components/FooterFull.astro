---
/** Full footer (home, Claire, service pages). Compact logo top-left per design review. */
import Logo from './Logo.astro';
import { routes, ui, EMAIL_DAAN, EMAIL_INFO, PHONE_DISPLAY, PHONE_TEL, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---
<footer class="site-footer">
  <div class="wrap inner">
    <div class="cols">
      <div class="col col--brand">
        <div class="lockup">
          <Logo mode="mark" h={26} />
          <span class="name">DataFlowr</span>
        </div>
        <p class="tagline">{t.footerTagline}</p>
        <p class="body">{t.footerBody}</p>
      </div>
      <div class="col">
        <p class="heading">{t.footerContact}</p>
        <div class="links">
          <a href={`mailto:${EMAIL_DAAN}`}>{EMAIL_DAAN}</a>
          <a href={`mailto:${EMAIL_INFO}`}>{EMAIL_INFO}</a>
          <a href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY[lang]}</a>
        </div>
      </div>
      <div class="col">
        <p class="heading">{t.footerExplore}</p>
        <div class="links">
          <a href={routes.servicesIndex[lang]}>{t.servicesIndex}</a>
          <a href={routes.claire[lang]}>Claire</a>
          <a href={routes.resources[lang]}>{t.resources}</a>
        </div>
      </div>
    </div>
    <div class="legal">
      <div class="legal-run">
        <span>{t.footerCopyright}</span>
        <span class="dot" aria-hidden="true">·</span>
        <a href={routes.legal.privacy[lang]}>{t.footerPrivacy}</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href={routes.legal.terms[lang]}>{t.footerTerms}</a>
      </div>
      <span class="motto">{t.footerMotto} <span class="exact-logo" role="img" aria-label="Exact"><span class="exact-eq" aria-hidden="true"></span>exact</span></span>
    </div>
  </div>
</footer>

<style>
  .inner { padding-top: 76px; padding-bottom: 32px; }
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    justify-content: space-between;
    padding-bottom: 60px;
  }
  .col { flex: 0 1 auto; }
  .col--brand { flex: 1 1 300px; min-width: 0; }
  .lockup { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .name { font-size: 1.28125rem; font-weight: 700; letter-spacing: -0.02em; color: var(--brand); }
  .tagline, .heading {
    margin: 0 0 12px;
    font-size: 0.71875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .heading { margin-bottom: 14px; }
  .body { margin: 0; max-width: 340px; font-size: 0.90625rem; line-height: 1.65; color: var(--muted); }
  .links { display: grid; gap: 9px; font-size: 0.9375rem; }
  .legal {
    border-top: 1px solid color-mix(in srgb, var(--brand) 9%, transparent);
    padding-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    align-items: center;
    font-size: 0.84375rem;
    color: var(--muted);
  }
  .legal-run { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .legal-run a { color: inherit; }
  .legal-run a:hover { color: var(--hl); }
  .dot { color: color-mix(in srgb, var(--brand) 28%, transparent); }
  .motto {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .exact-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.14em;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: lowercase;
    /* Exact brand chrome, not palette 0a: same red as the =exact tile on the Claire page. */
    color: #E30613;
    transform: translateY(-1px);
  }
  .exact-eq {
    display: inline-block;
    width: 0.6em;
    height: 0.44em;
    border-top: 0.16em solid currentColor;
    border-bottom: 0.16em solid currentColor;
  }
</style>
