---
import DocPage from '../../components/pages/DocPage.astro';
import { routes, type DocKey } from '../../lib/site';

export function getStaticPaths() {
  return (Object.keys(routes.docPages) as DocKey[]).map((key) => ({
    params: { slug: routes.docPages[key].nl.split('/').pop()! },
    props: { docKey: key },
  }));
}
const { docKey } = Astro.props;
---
<DocPage lang="nl" docKey={docKey} />
