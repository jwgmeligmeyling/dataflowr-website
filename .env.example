# Configuration for POST /api/subscribe (the signup forms). Without these the
# endpoint answers `not_configured` and logs each address instead of storing
# it. Set them in the Vercel project settings for production; locally a .env
# file next to this one feeds `astro dev`. See CLAUDE.md, "Newsletter and
# whitepaper".

# Which mailing provider to forward signups to: laposta | brevo
NEWSLETTER_PROVIDER=laposta

# Laposta (laposta.nl): API key under Instellingen > API. The list ids are on
# each list's settings page. Double opt-in and the welcome mail that delivers
# the whitepaper are configured on the list, not here.
LAPOSTA_API_KEY=
LAPOSTA_LIST_NEWSLETTER=
LAPOSTA_LIST_WHITEPAPER=

# Brevo (brevo.com): API key under SMTP & API. List ids are numeric.
#BREVO_API_KEY=
#BREVO_LIST_NEWSLETTER=
#BREVO_LIST_WHITEPAPER=

# The providers store no language of their own, so to send Dutch and English
# readers different mailings, give each language its own list: a _NL / _EN
# suffix on any list var above wins for that language (for either provider,
# e.g. LAPOSTA_LIST_NEWSLETTER_EN). Without a suffixed var the unsuffixed
# list takes both languages.
